# Production URL, no trailing slash. Used for canonicals, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://selitve-mormo.si

# Resend (https://resend.com): create an API key and verify the sending domain.
RESEND_API_KEY=
# Sender on the verified domain, e.g. "Selitve Mormo <povprasevanje@selitve-mormo.si>"
INQUIRY_FROM=
# Where inquiries are delivered. Comma-separated for several recipients.
INQUIRY_TO=luka@mormo.si

# Local development only: without a Resend key, log inquiries to the console and report success.
# Ignored in production.
# INQUIRY_DRY_RUN=1
